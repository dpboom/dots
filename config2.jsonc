{
"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
"logo": {
	/* "source: "/path/to img", */
    "height": 15,
    "width": 10
  },
  "modules": [
{
	"type": "os",
	"key": "",
	"format": "{pretty-name}",
	"keyColor": "#ffffff"
},
{
    "type": "shell",
    "key": "",
    "keyColor": "#ffffff",
    "format": "{pretty-name}"
},
{
    "type": "wm",
    "key": "󱂬",
    "keyColor": "#ffffff",
    "format": "{pretty-name}"
},
{
    "type": "terminal",
    "key": "",
    "keyColor": "#ffffff",
    "format": "{pretty-name}"
},
{
    "type": "cpu",
    "keyColor": "#ffffff",
    "key": "󰍛"
},
{
	"type": "gpu",
	"keyColor": "#ffffff",
	"key": ""
},
    {
    "type": "memory",
    "keyColor": "#ffffff",
    "key": ""
    }
]
}
